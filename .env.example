# LLM providers — exact model IDs verified 2026-10-25 against each provider's own API
# (model list + a real call). Re-verify if you submit much later; providers deprecate fast.
# You need at least TWO different providers with keys set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional extra provider (leave the key empty to disable): set STRONG_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Router: which provider handles cheap/simple work vs. heavy synthesis.
# Values: openai | nvidia | anthropic
CHEAP_PROVIDER=nvidia
STRONG_PROVIDER=openai

# Embeddings: "openai" (text-embedding-3-small) or "local" (sentence-transformers)
EMBEDDING_BACKEND=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Only used if EMBEDDING_BACKEND=local (also: pip install sentence-transformers)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
CHROMA_PERSIST_DIR=./chroma_index
CHROMA_COLLECTION=corpus
RAG_TOP_K=8

# Real-time knowledge (Tavily Remote MCP)
TAVILY_API_KEY=

# Data agent
SQLITE_PATH=./data/sample.db

# Cloud Run (used by deploy commands in README)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=multi-agent-rag
